# --- Required: your MyOnex / Auta ONEX app account (the same email + password you use in the app) ---
AUTA_USER=you@example.com
AUTA_PASS=your-app-password

# --- Optional ---
# The SIP registrar the monitor/panel use. Auta's shared production FreePBX; usually leave as-is.
# (The API reports a *different* host for the account domain — that one does NOT route the call.)
AUTA_PBX=ast-ssl.pro.auta.es

# Everything below is auto-discovered from the API (GET /SIP, /monitor, /plate).
# Only set them to override auto-discovery (e.g. several monitors/panels on the account).
# AUTA_SIP_EXTENSION=
# AUTA_SIP_PASSWORD=
# AUTA_MONITOR_ID=
# AUTA_MONITOR_EXT=
# AUTA_PLATE_NUMBER=

# Bridge bind (defaults are fine for a Home Assistant on the same host).
# AUTA_BRIDGE_HOST=127.0.0.1
# AUTA_BRIDGE_PORT=8092
