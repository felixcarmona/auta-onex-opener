# --- Required: your MyOnex / Auta ONEX app account (the same email + password you use in the app) ---
AUTA_USER=you@example.com
AUTA_PASS=your-app-password

# --- Optional ---
# The SIP registrar the monitor/panel use. Auta's shared production FreePBX; usually leave as-is.
# (The API reports a *different* host for the account domain — that one does NOT route the call.)
AUTA_PBX=ast-ssl.pro.auta.es

# Everything below is auto-discovered from the API (GET /SIP, /monitor, /plate).
# Only set them to override auto-discovery (e.g. several monitors/panels on the account).
# AUTA_SIP_EXTENSION=
# AUTA_SIP_PASSWORD=
# AUTA_MONITOR_ID=
# AUTA_MONITOR_EXT=
# AUTA_PLATE_NUMBER=

# Bridge bind (defaults are fine for a Home Assistant on the same host).
# AUTA_BRIDGE_HOST=127.0.0.1
# AUTA_BRIDGE_PORT=8092

# --- Optional: keep the monitor's cloud registration alive ---
# Some ONEX monitors run an old firmware whose registration to the cloud PBX goes "stale" after a
# few idle minutes: the monitor still thinks it's registered but the PBX can no longer reach it, so
# opens start failing with 503 until the monitor is rebooted. If you set AUTA_MONITOR_IP (your
# monitor's LAN IP), the bridge periodically pokes the monitor's *local* baresip control port to
# refresh the route (a SIP OPTIONS), and also self-heals a stale route on a failed open + retries.
# NOTE: this relies on that control port being open and unauthenticated on your LAN (it is, on these
# monitors) — keep the intercom on an isolated IoT VLAN. Off unless AUTA_MONITOR_IP is set.
# AUTA_MONITOR_IP=192.168.1.50
# AUTA_KEEPALIVE_INTERVAL=120
